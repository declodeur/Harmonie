root = true

[*.{kt,kts}]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 140
ktlint_code_style = intellij_idea
# Les fonctions @Composable commencent par une majuscule (convention Compose)
ktlint_function_naming_ignore_when_annotated_with = Composable
